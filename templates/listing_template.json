  "product_description": [
   {
    "language_tag": "en_US",
    "value": "<p><strong>Tired of blankets that slide off every time you reach for your phone or a cup of tea? This heated shawl wraps comfortably around your shoulders and stays put with a smart zip front design, delivering soothing warmth exactly where you need it most.</strong></p>\n<p><strong><br></strong></p>\n<p><strong>Why do we choose this product?</strong></p>\n<ol>\n    <li>Hands free zip front keeps the shawl securely in place</li>\n    <li>Three temperature levels for personalized comfort</li>\n    <li>USB powered design works with portable power banks</li>\n    <li>Soft double sided knit with plush inner lining</li>\n    <li>Lightweight and foldable for easy travel and storage</li>\n    <li>One button control for simple operation by anyone</li>\n    <li>Stylish cape shape suitable for home and office use</li>\n</ol>\n<p><br></p>\n<p><strong>Product Information:</strong></p>\n<ul>\n    <li>Product Name: Heated Shawl Wraps for Women</li>\n    <li>Material: Textured Knit Outer Layer with Plush Inner Lining</li>\n    <li>Available Colors: Red, White, Khaki, Green</li>\n    <li>Size: 150 × 80 cm (59.06 × 31.50 in)</li>\n    <li>Power: DC 5V USB, 10W Input</li>\n    <li>Heat Settings: Approximately 95°F, 113°F, 131°F</li>\n</ul>\n<p><br></p>\n<p><strong>Package Includes:</strong></p>\n<ul>\n    <li>1 x Heated Shawl Wrap</li>\n</ul>\n<p><br></p>\n<p><strong>Notes:</strong></p>\n<ol>\n    <li>Due to manual measurements, please allow slight measurement deviations.</li>\n    <li>Due to the different display and lighting effects, the actual color of the item may be slightly different from the color displayed on the picture.</li>\n    <li>Do not use this product while sleeping or unattended. Keep away from water and liquids to avoid electrical hazards.</li>\n    <li>If you have any questions or issues during use, please reach out to us via Amazon messages. We will assist you as soon as possible.</li>\n</ol>",
    "marketplace_id": "ATVPDKIKX0DER"
   }
