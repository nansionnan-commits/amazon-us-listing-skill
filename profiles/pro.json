{
  "_desc": "精做版 —— 适合主推款。全量竞品拆解、关键词反查、差异化文案、严格校验、提交前人工确认。",
  "competitor_analysis": {
    "depth": "full",
    "fetch_bullets": true,
    "fetch_description": true,
